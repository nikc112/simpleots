# Basis-URL der Anwendung (wichtig für Cookies/CSRF)
# Lokal: http://localhost:7143
# Prod:  https://deine-domain.de
BASE_URL=http://localhost:7143

# Zufälliger Master-Key zur Verschlüsselung (mind. 64 Zeichen)
# Generieren z.B. mit: openssl rand -hex 32
MASTER_KEY=change_me_to_a_secure_random_string_at_least_64_chars_long

# Redis Konfiguration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Admin Timeout in Sekunden
ADMIN_TIMEOUT=300
